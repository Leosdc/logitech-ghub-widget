<Window x:Class="GHubWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GHubWidget"
        mc:Ignorable="d"
        Title="Logitech G HUB Widget"
        Width="460"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Windows 11 Dynamic Theme Brushes (Overridden at runtime based on theme) -->
        <SolidColorBrush x:Key="Win11WindowBg" Color="#202020"/>
        <SolidColorBrush x:Key="Win11TitleBarBg" Color="#262626"/>
        <SolidColorBrush x:Key="Win11WindowBorder" Color="#383838"/>
        <SolidColorBrush x:Key="Win11CardBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Win11CardBorder" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="Win11TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Win11TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="Win11TextMuted" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="Win11SegmentedBg" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="Win11SegmentedActive" Color="#333333"/>
        <SolidColorBrush x:Key="Win11ProgressTrack" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Win11ButtonBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="Win11ButtonBorder" Color="#3E3E3E"/>

        <!-- Windows 11 Minimalist Scrollbar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#45888888" CornerRadius="4" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Caption Button -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Win11TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Toggle Switch -->
        <Style x:Key="Win11ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="#404040" BorderBrush="#606060" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Win11Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Win11Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#000000"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Standard Button -->
        <Style x:Key="Win11Button" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Win11ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Win11TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Win11ButtonBorder}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Win11Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button -->
        <Style x:Key="SegmentedTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Win11TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Win11SegmentedActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Win11TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Option Button -->
        <Style x:Key="PillOptionButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource Win11ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Win11ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Win11Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Win11TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Win11Accent}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Win11Accent}"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="14" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>

        <Border x:Name="MainFrame" CornerRadius="12" Background="{DynamicResource Win11WindowBg}" BorderBrush="{DynamicResource Win11WindowBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titlebar -->
                <Border Grid.Row="0" Background="{DynamicResource Win11TitleBarBg}" CornerRadius="12,12,0,0" Padding="16,10,12,10" MouseDown="Header_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="6" Background="#2060CDFF" BorderBrush="{DynamicResource Win11Accent}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="G" Foreground="{DynamicResource Win11Accent}" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Dispositivos Logitech" Foreground="{DynamicResource Win11TextPrimary}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource Win11ButtonBg}" BorderBrush="{DynamicResource Win11ButtonBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6CCB5F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="Conectado" Foreground="{DynamicResource Win11TextSecondary}" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CaptionButton}" ToolTip="Atualizar agora" Click="BtnRefresh_Click">
                                <TextBlock Text="↻" FontSize="14" FontWeight="Bold"/>
                            </Button>
                            <Button x:Name="BtnPin" Style="{StaticResource CaptionButton}" ToolTip="Alternar Sempre no Topo / Na Area de Trabalho" Click="BtnPin_Click">
                                <TextBlock x:Name="TxtPinIcon" Text="🔝" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource CaptionButton}" ToolTip="Minimizar para a Bandeja" Click="BtnMinimize_Click">
                                <TextBlock Text="—" FontSize="11" Margin="0,0,0,2"/>
                            </Button>
                            <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Fechar / Ocultar" Click="BtnClose_Click">
                                <TextBlock Text="✕" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tab Switcher -->
                <Border Grid.Row="1" Background="{DynamicResource Win11TitleBarBg}" BorderBrush="{DynamicResource Win11WindowBorder}" BorderThickness="0,0,0,1" Padding="16,0,16,10">
                    <Border Background="{DynamicResource Win11SegmentedBg}" CornerRadius="8" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TabDevices" Grid.Column="0" Content="🎧  Dispositivos" IsChecked="True" Style="{StaticResource SegmentedTabButton}" Checked="Tab_Changed"/>
                            <RadioButton x:Name="TabSettings" Grid.Column="1" Content="⚙️  Configurações" Style="{StaticResource SegmentedTabButton}" Checked="Tab_Changed"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Body Area -->
                <Grid Grid.Row="2" Margin="16,14,16,12">
                    <!-- View Devices -->
                    <Grid x:Name="ViewDevices" Visibility="Visible">
                        <Border x:Name="ConnectingPanel" Visibility="Collapsed" Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="28" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource Win11Accent}"/>
                                <TextBlock Text="Procurando Logitech G HUB..." Foreground="{DynamicResource Win11TextPrimary}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="Abra o Logitech G HUB ou aguarde a reconexão automática." Foreground="{DynamicResource Win11TextSecondary}" FontSize="13" Margin="0,8,0,20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <Button Content="Abrir Logitech G HUB" Style="{StaticResource Win11Button}" HorizontalAlignment="Center" Click="BtnLaunchGHub_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="DevicesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DevicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Opacity="{Binding CardOpacity}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Win11WindowBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding DeviceCategoryIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Win11TextPrimary}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DeviceCategoryLabel}" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border CornerRadius="10" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" Padding="7,3" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeFg}" FontWeight="SemiBold" FontSize="10.5"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border CornerRadius="4" Background="{DynamicResource Win11ButtonBg}" BorderBrush="{DynamicResource Win11ButtonBorder}" BorderThickness="1" Padding="7,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ConnectionType}" Foreground="{DynamicResource Win11Accent}" FontWeight="SemiBold" FontSize="10.5"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" Margin="0,4,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <Border Height="6" Background="{DynamicResource Win11ProgressTrack}" CornerRadius="3" ClipToBounds="True">
                                                            <ProgressBar Value="{Binding BatteryProgressValue, Mode=OneWay}" Maximum="100" Height="6" Foreground="{Binding BatteryColor}" Background="Transparent" BorderThickness="0"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedPercentage}" Foreground="{Binding BatteryColor}" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedMileage}" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedConsumption}" Foreground="{DynamicResource Win11TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <!-- View Settings -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="PREFERÊNCIAS DO WIDGET" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>

                                <!-- Settings Card 0: THEME SELECTOR -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Tema de Aparência" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Seguir o tema do Windows ou escolher claro/escuro" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RadioThemeSystem" Content="🌗 Sistema" Style="{StaticResource PillOptionButton}" Checked="ThemeRadio_Changed"/>
                                            <RadioButton x:Name="RadioThemeLight" Content="☀️ Claro" Style="{StaticResource PillOptionButton}" Checked="ThemeRadio_Changed"/>
                                            <RadioButton x:Name="RadioThemeDark" Content="🌙 Escuro" Style="{StaticResource PillOptionButton}" Checked="ThemeRadio_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Settings Card 1: Always on Top -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Sempre no Topo" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Manter o widget visível sobre jogos e outras janelas" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Win11ToggleSwitch}" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- Settings Card 2: Pin to Desktop -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Fixar na Área de Trabalho" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Comportar-se como widget de fundo no papel de parede" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkPinToDesktop" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Win11ToggleSwitch}" Checked="ChkPinToDesktop_Changed" Unchecked="ChkPinToDesktop_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- Settings Card 3: Auto Start -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Iniciar com o Windows" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Abrir o widget automaticamente ao ligar o computador" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoStart" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Win11ToggleSwitch}" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- Settings Card 4: Low Battery Alert -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Alerta de Bateria Fraca" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Notificar quando a bateria de um periférico atingir 20%" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkLowBatteryAlert" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Win11ToggleSwitch}" Checked="ChkLowBatteryAlert_Changed" Unchecked="ChkLowBatteryAlert_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- Settings Card 5: Opacity Slider -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Opacidade da Janela" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtOpacityValue" Text="98%" HorizontalAlignment="Right" Foreground="{DynamicResource Win11Accent}" FontWeight="Bold" FontSize="13"/>
                                        </Grid>
                                        <Slider x:Name="SliderOpacity" Minimum="0.4" Maximum="1.0" Value="0.98" TickFrequency="0.05" ValueChanged="SliderOpacity_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Settings Card 6: Refresh Interval (Pill Selection - No Popup Bugs!) -->
                                <Border Background="{DynamicResource Win11CardBg}" BorderBrush="{DynamicResource Win11CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Intervalo de Atualização" Foreground="{DynamicResource Win11TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Frequência de consulta de bateria ao G HUB" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RadioInterval2" Content="2s" Style="{StaticResource PillOptionButton}" Checked="IntervalRadio_Changed"/>
                                            <RadioButton x:Name="RadioInterval5" Content="5s" IsChecked="True" Style="{StaticResource PillOptionButton}" Checked="IntervalRadio_Changed"/>
                                            <RadioButton x:Name="RadioInterval15" Content="15s" Style="{StaticResource PillOptionButton}" Checked="IntervalRadio_Changed"/>
                                            <RadioButton x:Name="RadioInterval30" Content="30s" Style="{StaticResource PillOptionButton}" Checked="IntervalRadio_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Action: Open Official G HUB -->
                                <Button Content="Abrir Logitech G HUB Oficial" Style="{StaticResource Win11Button}" Height="38" Margin="0,0,0,6" Click="BtnLaunchGHub_Click"/>
                                <TextBlock Text="✔ Conecta com segurança via ws://localhost:9010 sem alterar arquivos oficiais." Foreground="{DynamicResource Win11TextMuted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="3" Background="{DynamicResource Win11TitleBarBg}" BorderBrush="{DynamicResource Win11WindowBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtFooterInfo" Grid.Column="0" Text="3 dispositivos conectados" Foreground="{DynamicResource Win11TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource Win11Button}" Padding="12,4" ToolTip="Abre o painel completo do G HUB" Click="BtnLaunchGHub_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="G HUB" Foreground="{DynamicResource Win11Accent}" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="↗" Foreground="{DynamicResource Win11TextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
